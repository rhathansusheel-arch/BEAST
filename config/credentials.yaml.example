# Copy to config/credentials.yaml (gitignored) OR use .env - both are read.
# Environment variables take precedence over this file, so CI and containers can
# inject secrets without a file on disk.

zerodha:
  api_key: your_key_here
  secret_key: your_secret_here
  access_token: ""        # refreshed daily by the Kite login flow
  paper: true

# MetaTrader 5 credentials are deliberately NOT here. broker/mt5_connection.py
# reads them from the environment only - MT5_GOLD_LOGIN, MT5_GOLD_PASSWORD,
# MT5_GOLD_SERVER - so there is exactly one place a trading password can live.
# Use .env (gitignored) or real environment variables. See .env.example.

anthropic:
  api_key: your_key_here

alerts:
  smtp_user: ""
  smtp_password: ""
  webhook_url: ""
