# Copy to config/credentials.yaml (gitignored) OR use .env - both are read.
# Environment variables take precedence over this file, so CI and containers can
# inject secrets without a file on disk.

zerodha:
  api_key: your_key_here
  secret_key: your_secret_here
  access_token: ""        # refreshed daily by the Kite login flow
  paper: true

# No live XAUUSD venue is configured. Gold routes to broker/paper_broker.py, the
# simulated venue. Credentials go here once instruments.gold.venue is chosen
# (soul file open item 17 - COMEX GC, MCX Gold/Gold Mini, or a broker CFD).

anthropic:
  api_key: your_key_here

alerts:
  smtp_user: ""
  smtp_password: ""
  webhook_url: ""
