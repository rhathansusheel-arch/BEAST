# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Zerodha (Nifty / Sensex: index spot + weekly option chain) --------------
ZERODHA_API_KEY=your_key_here
ZERODHA_SECRET_KEY=your_secret_here
ZERODHA_ACCESS_TOKEN=
ZERODHA_PAPER=true

# --- MetaTrader 5 (XAUUSD: spot data + execution) ----------------------------
# Read by broker/mt5_connection.py, from the ENVIRONMENT ONLY - these never go in
# beast_config.yaml or credentials.yaml. The prefix comes from the connection
# profile (broker.mt5.profiles.gold.env_prefix), so a second terminal later is
# MT5_INDEX_* with no code change.
# _LOGIN is the numeric account number. _SERVER must match the broker's server
# string exactly as the terminal shows it. _TERMINAL_PATH is optional and only
# needed when several terminals are installed.
MT5_GOLD_LOGIN=
MT5_GOLD_PASSWORD=
MT5_GOLD_SERVER=
MT5_GOLD_TERMINAL_PATH=
# Set to 1 when the terminal is started with /portable (the VPS units do). The
# IPC endpoint name is derived from the data location, so this must match.
MT5_GOLD_PORTABLE=

# Second switch for live trading. broker.mt5.account_mode must ALSO be `live`.
# Leave this unset for a demo account; the handshake refuses to trade a real
# account without it.
BEAST_ALLOW_LIVE=

# --- Telegram alerts ---------------------------------------------------------
# Set monitoring.alerts.telegram_enabled: true in beast_config.yaml to turn on.
BEAST_TELEGRAM_TOKEN=
BEAST_TELEGRAM_CHAT_ID=

# Gold contract specs remain unset and are treated as FAILING, not passing:
# instruments.gold.{venue,contract_multiplier,tick_size,tick_value} are null
# (soul file open item 17). MT5 serves XAUUSD as a spot CFD sized in lots, so
# those keys still need operator answers before gold trades are sized.

# --- Anthropic (Claude narration / weekly review layer) ----------------------
ANTHROPIC_API_KEY=your_key_here

# --- Alerts (optional) -------------------------------------------------------
BEAST_SMTP_USER=
BEAST_SMTP_PASSWORD=
BEAST_ALERT_WEBHOOK_URL=
