# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Zerodha (Nifty / Sensex: index spot + weekly option chain) --------------
ZERODHA_API_KEY=your_key_here
ZERODHA_SECRET_KEY=your_secret_here
ZERODHA_ACCESS_TOKEN=
ZERODHA_PAPER=true

# --- XAUUSD / Gold -----------------------------------------------------------
# No live gold venue is configured. XAUUSD routes to broker/paper_broker.py, the
# simulated venue, and instruments.gold.{venue,contract_multiplier,tick_size,
# tick_value} are all null and treated as failing (soul file open item 17).
# Credentials go here once a venue is chosen.

# --- Anthropic (Claude narration / weekly review layer) ----------------------
ANTHROPIC_API_KEY=your_key_here

# --- Alerts (optional) -------------------------------------------------------
BEAST_SMTP_USER=
BEAST_SMTP_PASSWORD=
BEAST_ALERT_WEBHOOK_URL=
